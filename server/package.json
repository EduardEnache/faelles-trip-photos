{
  "name": "faelles-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^9.3.0",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.5",
    "ulid": "^3.0.2",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "tus-js-client": "^4.3.1",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
